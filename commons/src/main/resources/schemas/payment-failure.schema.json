{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaymentFailure",
  "type": "object",
  "required": [
    "orderId",
    "provider",
    "reason",
    "failedAt"
  ],
  "properties": {
    "orderId": {
      "type": "integer"
    },
    "provider": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "failedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}