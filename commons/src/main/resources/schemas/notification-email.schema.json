{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NotificationEmail",
  "type": "object",
  "required": [
    "toEmail",
    "subject",
    "body",
    "queuedAt",
    "correlationId"
  ],
  "properties": {
    "toEmail": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "queuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    }
  }
}