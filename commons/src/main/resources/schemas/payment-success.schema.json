{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaymentSuccess",
  "type": "object",
  "required": [
    "orderId",
    "provider",
    "authorizedAt"
  ],
  "properties": {
    "orderId": {
      "type": "integer"
    },
    "authCode": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "authorizedAt": {
      "type": "string",
      "format": "date-time"
    },
    "invoiceUrl": {
      "type": "string"
    }
  }
}