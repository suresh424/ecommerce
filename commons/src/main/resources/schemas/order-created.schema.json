{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderCreated",
  "type": "object",
  "required": [
    "orderId",
    "requestId",
    "currency",
    "subtotal",
    "tax",
    "shippingFee",
    "total",
    "customerId",
    "items",
    "createdAt"
  ],
  "properties": {
    "orderId": {
      "type": "integer"
    },
    "requestId": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "shippingFee": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "customerId": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "productId",
          "quantity",
          "unitPrice"
        ],
        "properties": {
          "productId": {
            "type": "integer"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "type": "number"
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}